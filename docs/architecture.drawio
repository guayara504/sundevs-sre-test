oint x="60" y="870"/></Array></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;Flujo:&lt;/b&gt; 1 request HTTPS · 2 integración proxy · 3 Redis HIT → responde (X-Cache: HIT) · 4 MISS → DynamoDB · 5 procesa y guarda en S3 → SET con TTL 60 s (X-Cache: MISS)&lt;br&gt;&lt;b&gt;Línea continua&lt;/b&gt; = request/datos · &lt;b&gt;punteada&lt;/b&gt; = replicación, monitoreo y DR · &lt;b&gt;RPO&lt;/b&gt; segundos–minutos · &lt;b&gt;RTO&lt;/b&gt; ~15–25 min" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=#D5DBDB;fillColor=#FAFAFA;spacing=8;" vertex="1" parent="1"><mxGeometry x="190" y="905" width="1430" height="50" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>