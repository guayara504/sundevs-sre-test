geStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c52" target="c53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c77" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#232F3E;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c54" target="c55"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c79" value="GET /health" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#7D8998;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c53" target="c30"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1395" y="88"/><mxPoint x="286" y="88"/></Array></mxGeometry></mxCell><mxCell id="c80" value="repository_dispatch → terraform apply" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;endSize=6;strokeWidth=1.5;strokeColor=#7D8998;fontSize=10;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;dashed=1;dashPattern=6 4;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c55" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1575" y="928"/><mxPoint x="8" y="928"/><mxPoint x="8" y="832"/></Array></mxGeometry></mxCell><mxCell id="c81" value="&lt;b&gt;Flujo&lt;/b&gt; &amp;nbsp;① Cliente → API Gateway (HTTPS) &amp;nbsp;② Integración proxy → Lambda (subnets privadas) &amp;nbsp;③ Redis GET → &lt;b&gt;HIT&lt;/b&gt;: responde &lt;i&gt;X-Cache: HIT&lt;/i&gt; &amp;nbsp;④ MISS → DynamoDB (si existe, no reprocesa) &amp;nbsp;⑤ Procesa → S3 &lt;i&gt;results/fecha/id.json&lt;/i&gt; + DynamoDB → Redis SET TTL 60 s → &lt;i&gt;X-Cache: MISS&lt;/i&gt;&lt;br&gt;&lt;b&gt;Convenciones&lt;/b&gt; &amp;nbsp;línea continua = request/datos · punteada = replicación, monitoreo y DR · S3 y DynamoDB solo por gateway endpoints (forzado por bucket policy) · &lt;b&gt;DR&lt;/b&gt;: RPO segundos–minutos · RTO ~15–25 min · costo en standby &amp;lt; USD 2/mes" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=#D5DBDB;fillColor=#FAFAFA;spacingLeft=10;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="200" y="955" width="1470" height="58" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>